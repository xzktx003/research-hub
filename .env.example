# Copy to .env for docker compose or shell deployment.
#
# Public port on the host. The container always listens on 8080.
RESEARCH_HUB_PUBLIC_PORT=8310
RESEARCH_HUB_PUBLIC=true

# API key for write-protecting /api/v1/* mutation endpoints.
# Required for any public mode deployment or tunnel. Generate a long random value.
RESEARCH_HUB_API_KEY=
RESEARCH_HUB_ADMIN_API_KEY=
RESEARCH_HUB_RESEARCHER_API_KEY=
RESEARCH_HUB_PATENT_EDITOR_API_KEY=
RESEARCH_HUB_READ_ONLY_API_KEY=

# Runtime paths used by the container.
RESEARCH_HUB_HOST=0.0.0.0
RESEARCH_HUB_PORT=8080
RESEARCH_HUB_DB=/data/research_hub.sqlite3
RESEARCH_HUB_RUNTIME_CONFIG=/data/runtime_config.json
RESEARCH_HUB_STATIC_DIR=/app/web
RESEARCH_HUB_EXPORT_DIR=/app/exports
RESEARCH_HUB_ARTIFACT_ROOT=/app/artifacts
PATENT_DISCLOSURE_ROOT=/app/patent-disclosure-skill
# Optional non-root Chromium shared-library directory for Mermaid/CNIPA tools.
RESEARCH_HUB_CHROMIUM_LIB_DIR=
RESEARCH_HUB_TIMEZONE=Asia/Shanghai
RESEARCH_HUB_DAILY_HOUR=9
RESEARCH_HUB_DISCOVERY_LOOKBACK_DAYS=7
RESEARCH_HUB_DAILY_ENABLED=true
RESEARCH_HUB_AUTO_PROCESS=true

# Optional PostgreSQL runtime and migration target. Leave blank for SQLite.
# For Compose PostgreSQL, set this through a secret manager or local .env to:
# postgresql://research_hub:<password>@postgres:5432/research_hub
RESEARCH_HUB_POSTGRES_DSN=
POSTGRES_DB=research_hub
POSTGRES_USER=research_hub
POSTGRES_PASSWORD=

# Optional paper-reading model. Leave blank and configure it later in Settings.
RESEARCH_HUB_ANALYSIS_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Dify workflow provider and server-managed MinerU adapter. When absent,
# adapter health reports degraded instead of pretending the service is available.
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=
MINERU_BASE_URL=
MINERU_API_KEY=

# Optional arXiv discovery controls used by CLI/API discovery wiring.
ARXIV_RATE_LIMIT_SECONDS=3

# Artifact/export retention planning. The retention script is dry-run by
# default and only deletes when --delete is passed.
RESEARCH_HUB_RETENTION_DAYS=30

# Local verification helper only. Do not deploy this variable to the container.
# PUBLIC_VERIFY_API_KEY=
